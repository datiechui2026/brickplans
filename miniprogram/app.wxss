/* BrickPlan Mini Program - global styles.
   Theme mirrors the web SPA: brick-orange accent (#ea580c), card surfaces,
   soft shadows, rounded corners. */

page {
  --bp-orange: #ea580c;
  --bp-orange-light: #fb923c;
  --bp-bg: #f5f5f5;
  --bp-card: #ffffff;
  --bp-text: #1f2937;
  --bp-text-muted: #6b7280;
  --bp-border: #e5e7eb;
  background-color: var(--bp-bg);
  color: var(--bp-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, scroll-view, swiper, swiper-item { box-sizing: border-box; }

.page {
  min-height: 100vh;
  padding: 24rpx;
}

/* Cards */
.card {
  background: var(--bp-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}
.btn::after { border: none; }
.btn-primary { background: var(--bp-orange); color: #fff; }
.btn-ghost { background: #f3f4f6; color: var(--bp-text); }
.btn-block { display: flex; width: 100%; }

/* Text helpers */
.muted { color: var(--bp-text-muted); }
.title-lg { font-size: 40rpx; font-weight: 700; }
.title { font-size: 32rpx; font-weight: 600; }
.row { display: flex; flex-direction: row; align-items: center; }
.row-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* Tag pill */
.tag-pill {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin: 6rpx 6rpx 6rpx 0;
  background: #fff7ed;
  color: var(--bp-orange);
  border-radius: 999rpx;
  font-size: 24rpx;
}

/* Grid for blueprint cards */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

/* Section header */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}
.section-header .title { font-size: 34rpx; }
