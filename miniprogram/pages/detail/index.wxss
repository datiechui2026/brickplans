.detail { padding-bottom: 0; }

.gallery {
  width: 100%;
  height: 560rpx;
  background: #f3f4f6;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.gallery-img { width: 100%; height: 100%; }
.gallery-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.pdf-card { padding: 20rpx 24rpx; }
.pdf-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.pdf-item:last-child { border-bottom: none; }
.pdf-name { font-size: 28rpx; }
.pdf-open { color: #ea580c; font-size: 26rpx; }

.info-card .bp-title { font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.author-row { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
}
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  background: #fff7ed;
}
.author-name { font-size: 26rpx; font-weight: 600; }
.author-row .muted { font-size: 22rpx; margin-left: auto; }

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 32rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
.meta-item { display: flex; flex-direction: column; gap: 4rpx; font-size: 26rpx; }
.meta-item .muted { font-size: 22rpx; }

.stat-row {
  display: flex;
  gap: 28rpx;
  margin-top: 20rpx;
}
.stat { font-size: 24rpx; color: #6b7280; }

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}
.action-btn.on { background: #fff7ed; color: #ea580c; }

.desc { margin-top: 12rpx; font-size: 28rpx; line-height: 1.7; }

.part-list { margin-top: 12rpx; }
.part-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 26rpx;
}
.part-row:last-child { border-bottom: none; }

.tag-list { margin-top: 12rpx; }

.comment-list { margin-top: 12rpx; }
.comment { display: flex; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.comment:last-child { border-bottom: none; }
.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f3f4f6;
}
.c-avatar-fallback { display: flex; align-items: center; justify-content: center; font-size: 30rpx; background: #fff7ed; }
.c-body { flex: 1; }
.c-head { display: flex; align-items: center; gap: 12rpx; }
.c-name { font-size: 24rpx; font-weight: 600; color: #4b5563; }
.c-time { font-size: 22rpx; }
.c-content { font-size: 28rpx; margin: 8rpx 0; line-height: 1.5; }
.c-reply { font-size: 22rpx; color: #ea580c; }
.reply-list {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}
.reply { font-size: 26rpx; padding: 6rpx 0; line-height: 1.5; }
.reply-content { margin-left: 8rpx; color: #374151; }

.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.reply-hint {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #6b7280;
  padding: 4rpx 4rpx 8rpx;
}
.reply-cancel { color: #ea580c; }
.comment-input-row { display: flex; gap: 12rpx; align-items: center; }
.comment-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
}
.send-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #ea580c;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}
.send-btn::after { border: none; }
.send-btn[disabled] { background: #fdba74; color: #fff; }

.error-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx;
  text-align: center;
  color: #6b7280;
}

/* Report modal */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}
.modal-title { font-size: 32rpx; font-weight: 700; }
.modal-sub { font-size: 24rpx; margin: 8rpx 0 16rpx; }
.reason-list { margin-bottom: 16rpx; }
.reason-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
}
.reason-item.active { color: #ea580c; }
.reason-check { color: #ea580c; }
.reason-detail {
  width: 100%;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  min-height: 120rpx;
  box-sizing: border-box;
}
.modal-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.modal-actions .btn { flex: 1; }
