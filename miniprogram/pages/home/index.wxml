<view class="page home">
  <!-- Hero -->
  <view class="hero card">
    <view class="hero-title">🧱 BrickPlan</view>
    <view class="hero-sub muted">发现积木MOC创意图纸</view>
  </view>

  <!-- Category quick nav -->
  <view class="cats">
    <view wx:for="{{categories}}" wx:key="value" class="cat-chip" bindtap="goCategory" data-cat="{{item.value}}">
      <text class="cat-emoji">{{item.emoji}}</text>
      <text class="cat-name">{{item.label}}</text>
    </view>
  </view>

  <!-- Popular -->
  <view class="section-header">
    <text class="title">🔥 热门推荐</text>
    <text class="muted more" bindtap="goExplore">查看全部 ›</text>
  </view>

  <loading wx:if="{{loading}}" />
  <view wx:elif="{{error}}" class="error-box" bindtap="load">
    <text>{{error}}</text>
    <text class="muted">点击重试</text>
  </view>
  <block wx:else>
    <view wx:if="{{popular.length}}" class="grid">
      <bp-card wx:for="{{popular}}" wx:key="id" blueprint="{{item}}" />
    </view>
    <empty wx:else text="还没有图纸，快来上传第一个吧！" icon="🧱" />
  </block>
</view>
